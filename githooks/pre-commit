#!/usr/bin/env bash
# handsoff pre-commit gate — a self-edit that breaks the suite cannot be committed.
#
# Enabled by `git config core.hooksPath githooks` (pinned by
# test_precommit_hook_is_versioned). Skip deliberately with:
#   git commit --no-verify
set -u

# Only gate commits that actually change shipped sources; commits touching
# nothing (rare) pass through.
changed=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$changed" ]; then
    exit 0
fi

# THE COMMIT, NOT THE WORKING TREE. Every file-shaped check below answers a
# question about the tree the commit will CONTAIN, and the file on disk is a
# different tree: a stage holding only part of a change ships a commit whose own
# spec disagrees with its own code, and the working tree hides it, because there
# the two agree. Measured, not theorised — two commits on main (`bd9cf5a`,
# `baf58c5`) each passed this hook and were refused by a clean checkout of
# themselves, the second because the regenerated architecture table was staged
# nowhere while the module it prices was. So the index is written out ONCE here
# and the checks read from it. `checkout-index` is the only tool that writes
# exactly the index: a worktree checks out HEAD, and stashing to test would
# disturb the developer's other work — which is regularly another agent's.
staged=$(mktemp -d -t handsoff-staged-XXXXXX) || {
    echo "✗ pre-commit could not make a scratch directory for the staged tree,"
    echo "  and judging the working tree instead would answer a different question."
    exit 1
}
trap 'rm -rf "$staged"' EXIT INT TERM
if ! git checkout-index -a --prefix="$staged/"; then
    echo "✗ pre-commit could not write the staged tree out (git checkout-index)."
    exit 1
fi

fail=0

# 1. Byte-compile every staged Python source (cheap, catches syntax rot first).
# The STAGED copy: a file staged with a syntax error and then fixed on disk is
# still a broken commit, and compiling the working copy would call it good.
while IFS= read -r f; do
    [ -f "$staged/$f" ] || continue
    python3 -m py_compile "$staged/$f" || fail=1
done < <(echo "$changed" | grep '\.py$' || true)

# 2. Shell syntax for staged shell scripts — by SHEBANG, so an extensionless
# one (`handsoff-restart`, this hook itself) cannot slip past the check the
# way `*.sh` alone would miss it. The first line comes from the STAGED copy too:
# a script whose shebang is being added in this same commit is exactly the case
# the working-tree read got wrong.
while IFS= read -r f; do
    [ -f "$staged/$f" ] || continue
    case "$(head -1 "$staged/$f")" in
        '#!'*bash*|'#!'*'/sh'*) ;;
        *) continue ;;
    esac
    bash -n "$staged/$f" || fail=1
done < <(echo "$changed" || true)

# 3. The spec-vs-tree guard, against the STAGED tree. This is the check that
# closes the hole above: it is the one part of the suite whose verdict is about
# files and counts rather than behaviour, it needs nothing but the files
# themselves (no `.git`), and it costs seconds. The working tree passing proves
# nothing here, which is the entire point — it holds both halves of the change.
if [ -f "$staged/tests/test_specs_freshness.py" ]; then
    if ! (cd "$staged" && python3 -m pytest tests/test_specs_freshness.py -q \
              --tb=line -p no:cacheprovider); then
        echo
        echo "  The STAGED tree is what this commit will contain, and it does not"
        echo "  agree with its own spec. Stage the regenerated spec too (or unstage"
        echo "  the code), then commit again — the working tree holds both halves,"
        echo "  so it cannot show you this."
        fail=1
    fi
fi

# 4. The full suite whenever shipped sources changed — also against the STAGED
# tree, which is the behaviour half of the same question. This used to run in the
# working tree, for one reason: a file-only copy was assumed to need a `.git`.
# It does not — measured, the whole suite passes in a tree with no repository at
# all, and the only two checks that skip are the two that are ABOUT the working
# checkout (an untracked scratch file in a shipped directory, and the installer's
# fallback when there is no git tree). They still run whenever the suite is run
# directly, which the gates do. The copy is also where the run's artifacts land,
# so the developer's tree is left exactly as it was found.
#
# Deliberately broad: handsoff.py is both app and self-edit target, and the suite
# pins prompt text, tool census, and restart-script internals — narrow filters
# miss rot. Measured, not guessed: the suite is ~4 min (this line used to say
# ~10s, and the discrepancy is what makes a commit look HUNG — a 60s tool timeout
# kills a commit that is running the gate it is supposed to run). Either wait for
# it, or bypass deliberately with --no-verify and know what you skipped.
#
# SKIPPED when a leg above already failed: the suite CONTAINS the spec guard, so
# its verdict is already known in that case, and four minutes is a long time to
# wait to be told what the fast legs said in seconds.
if [ "$fail" -eq 0 ] && echo "$changed" | grep -qE '\.(py|sh)$|^install\.sh$|^handsoff-restart$|^pytest\.ini$|\.github/|\.gitlab-ci\.yml$'; then
    echo "pre-commit: running the test suite against the staged tree (~4 min)…"
    (cd "$staged" && python3 -m pytest tests/ -q) || fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "✗ pre-commit checks FAILED — commit refused (the self-edit would break the repo)."
    echo "  Fix the failure, or bypass deliberately with: git commit --no-verify"
    exit 1
fi
exit 0
