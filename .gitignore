# --- Python runtime artifacts ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
# coverage.py data files: .coveragerc sets parallel=True and the CI coverage job
# runs with --cov=., so a local run leaves `.coverage` plus `parallel = True`
# shards (`.coverage.<host>.<pid>.<rand>`). They are binaries, not source, and
# a `git add -A` would otherwise stage them.
.coverage
.coverage.*
htmlcov/

# --- handsoff runtime state (regenerated; never source control) ---
ruvector.db
ruvector.db-wal
ruvector.db-shm
xkiro_models.json
*.log
*.bak

# --- agent/tooling scratch dirs (not project source) ---
.freebuff/
.claude-flow/
.swarm/
.codex/
.agents/

# --- editor / OS noise ---
.DS_Store
*.swp
*~

# --- CI artifacts (regenerated by the suite's --junitxml run) ---
tests/report.xml

# --- handsoff self-edit / download / test leftovers ---
*.bak-*
.bak-handsoff
.json.bak-manual/
.bak-modelswitch/
*.part
*.tmp
voice-test.wav
voice-test-*.wav
niri-keybinds.kdl
