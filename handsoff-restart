#!/usr/bin/env bash
# handsoff-restart — stop the running bubble and start the (possibly self-edited) new one.
# Used by the assistant itself after edit_file, and by the "Restart" right-click menu.
set -u
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/handsoff"
LOG="$STATE/handsoff.log"
SCRIPT="$HOME/.local/bin/handsoff.py"
# ponytail: resolve once; venv's python3 wins when activated, system fallback otherwise.
PYBIN="${HANDSOFF_PYTHON:-$(command -v python3 2>/dev/null || echo /usr/bin/python3)}"
# A PYBIN that cannot run makes this script report a success it did not have:
# the launch is `nohup ... &` and its pid is echoed whether or not the process
# survived, so a bad HANDSOFF_PYTHON stopped a healthy bubble and left nothing
# running while saying "handsoff restarted (pid N)". Checked BEFORE anything is
# killed, so the failure is loud and costs nothing. This is not an injection
# guard: "$PYBIN" is quoted everywhere, so a value carrying shell
# metacharacters is one unusable path, not a command.
if [ ! -x "$PYBIN" ]; then
    echo "handsoff-restart: interpreter '$PYBIN' is not executable — set" \
         "HANDSOFF_PYTHON to a python3 this machine has" >&2
    exit 1
fi
mkdir -p "$STATE"

is_bubble_pid() {  # $1 = pid: python exe + EXACT cmdline match (never editors/pytest)
    local pid="$1" exe
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || return 1
    case "$(basename "$exe")" in
        python|python3|python[0-9].*) ;;
        *) return 1 ;;
    esac
    tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -qxF "$SCRIPT"
}

stop_instances() {
    local sig="$1" pid
    for pid in $(pgrep -f 'handsoff\.py' 2>/dev/null || true); do
        is_bubble_pid "$pid" || continue
        kill "-$sig" "$pid" 2>/dev/null || true
    done
}

# if systemd owns a running bubble, restart through it directly: manual
# TERM/KILL here would trigger the unit's Restart=always auto-spawn and race
# the explicit restart below (transient double bubble).
if systemctl --user is-active --quiet handsoff.service 2>/dev/null; then
    # A crash-looping unit trips StartLimitBurst, and the restart is then
    # DENIED — the old code printed success while nothing was running, which
    # is exactly the lie a self-modification loop acts on. reset-failed
    # clears the limit; the exit status is the answer, not a formality.
    systemctl --user reset-failed handsoff.service 2>/dev/null
    if systemctl --user restart handsoff.service; then
        echo "handsoff restarted via systemd"
        exit 0
    fi
    echo "handsoff-restart: systemctl restart failed — journalctl --user -u handsoff -n 20" >&2
    exit 1
fi

# unit not managing a bubble (stopped/failed/disabled): clear any manually
# spawned instance, then let systemd start a fresh one if it owns autostart
stop_instances TERM
sleep 0.4
stop_instances KILL

# wait for the lock to actually free, or the new instance will hit
# "already running, exiting" and leave nothing running.
# Narrowed match (same as the kill loop): a bare `pgrep -f handsoff.py`
# would wait on bystanders whose cmdline merely mentions the path
# (an editor with the file open, a running pytest run).
bubble_wait() {
    local pid
    for pid in $(pgrep -f 'handsoff\.py' 2>/dev/null || true); do
        # kill -0 + recheck closes the pgrep pid-reuse TOCTOU: a pid that
        # exited and was recycled between pgrep and the /proc read must not
        # keep us waiting (or be signalled).
        kill -0 "$pid" 2>/dev/null || continue
        is_bubble_pid "$pid" && return 0
    done
    # the pid may be gone while the lock/socket still linger; the new
    # instance needs both free (lock budget is ~10s: 40 x 0.25s in handsoff.py).
    if [ -e "$STATE/handsoff.lock" ] \
        && ! flock -n "$STATE/handsoff.lock" true 2>/dev/null; then
        return 0
    fi
    if [ -e "$STATE/control.sock" ]; then
        # A control.sock with no lock holder is a SIGKILL relic, not a
        # running bubble — and waiting the full budget on it made every
        # manual restart after a hard kill cost ten seconds. Clear it: the
        # new instance refuses to bind a socket that already exists.
        rm -f "$STATE/control.sock"
    fi
    return 1
}
for _ in $(seq 1 100); do
    bubble_wait || break
    sleep 0.1
done
if bubble_wait; then
    echo "handsoff-restart: something still holds the lock after 10s" \
         "(SIGSTOPped process?) — starting anyway" >&2
fi

if systemctl --user is-enabled --quiet handsoff.service 2>/dev/null; then
    systemctl --user reset-failed handsoff.service 2>/dev/null
    if systemctl --user restart handsoff.service; then
        echo "handsoff restarted via systemd"
        exit 0
    fi
    echo "handsoff-restart: systemctl restart failed — journalctl --user -u handsoff -n 20" >&2
    exit 1
fi

nohup setsid "$PYBIN" "$SCRIPT" >>"$LOG" 2>&1 &
disown
# A self-edit that dies at import leaves nothing running: say so instead of
# echoing a pid "whether or not the process survived".
pid=$!
sleep 1
if kill -0 "$pid" 2>/dev/null; then
    echo "handsoff restarted (pid $pid)"
else
    echo "handsoff-restart: the new process died within 1s — see $LOG" >&2
    exit 1
fi
