[run]
# Subprocess measurement: the offscreen-GUI scenarios (tests/test_settings_gui.py)
# drive handsoff-settings.py in child processes. With COVERAGE_PROCESS_START set
# (the CI coverage job exports it), those children start coverage via
# coverage.process_startup(); parallel suffixes keep their data files from
# clobbering the parent's, and pytest-cov combines them at session end.
parallel = True

omit =
    tests/*
    attic/*
    # Developer scratch at the repo root: untracked and gitignored, but
    # `--cov=.` measures it anyway, and 16 unmeasured lines drag the TOTAL
    # below the floor for reasons that have nothing to do with the suite.
    test.py
    # ci/pytest_summary.py is CI tooling but it *is* measured (94%, driven by
    # tests/test_ci_summary.py) — excluded code that is tested is how
    # regressions hide, so only the two archives above are omitted.
    */site-packages/*
    # PySide6's vendored shibokensupport/signature_bootstrap register paths
    # inside the project dir during Qt imports (the source lives in
    # site-packages); without this omit the coverage TOTAL is polluted with
    # unparseable phantom files.
    shibokensupport/*
    */signature_bootstrap.py

[report]
# Floor tracks measured reality, not aspiration: handsoff.py 71% (the offscreen
# bubble-render scenario took the ten designs out of the dark), hardware.py ~84%,
# core/assistant.py ~84%, core/theme.py 100%, ci/pytest_summary.py 94%, and the Qt
# settings GUI (handsoff-settings.py) ~68% since tests/test_settings_gui.py began
# driving it in offscreen subprocesses — TOTAL 75%. Raise further only with new
# tests, not omit-patterns.
fail_under = 70
show_missing = True
