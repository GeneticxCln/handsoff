[run]
# Subprocess measurement: the offscreen-GUI scenarios (tests/test_settings_gui.py)
# drive handsoff-settings.py in child processes. With COVERAGE_PROCESS_START set
# (the CI coverage job exports it), those children start coverage via
# coverage.process_startup(); parallel suffixes keep their data files from
# clobbering the parent's, and pytest-cov combines them at session end.
parallel = True

omit =
    tests/*
    attic/*
    # Developer scratch at the repo root: untracked and gitignored, but
    # `--cov=.` measures it anyway, and 16 unmeasured lines drag the TOTAL
    # below the floor for reasons that have nothing to do with the suite.
    test.py
    # ci/pytest_summary.py is CI tooling but it *is* measured (94%, driven by
    # tests/test_ci_summary.py) — excluded code that is tested is how
    # regressions hide, so only the two archives above are omitted.
    */site-packages/*
    # PySide6's vendored shibokensupport/signature_bootstrap register paths
    # inside the project dir during Qt imports (the source lives in
    # site-packages); without this omit the coverage TOTAL is polluted with
    # unparseable phantom files.
    shibokensupport/*
    */signature_bootstrap.py
    # The checkout-write guard's carrier: tests/conftest.py writes a one-module
    # `sitecustomize.py` into a scratch directory (so every python CHILD the suite
    # spawns is held to the same rule), and a child that starts coverage under
    # COVERAGE_PROCESS_START measures it — a file outside the checkout, which the
    # report then cannot find and refuses to print a TOTAL for. Not source, and
    # not the suite's: omitted rather than left to pollute the gate's output.
    */handsoff-guard-*/sitecustomize.py
    # The self-edit tests (tests/test_policy.py) write scratch `handsoff.py`
    # files under pytest's tmp tree, and `_import_smoke`'s child inherits
    # COVERAGE_PROCESS_START — so the coverage data arrives for fixtures the
    # report cannot trust: `test_a_new_file_that_cannot_load_is_removed_again`
    # asserts the half-installed file is DELETED (its rollback is the point),
    # leaving data with no source — the measured `No source for code:
    # /tmp/pytest-of-…/handsoff.py` warning of 2026-09-24 — while its three
    # write-keeping siblings show as 100% `/tmp/...` rows in the table. Test
    # fixture, not source: omitted rather than left to pollute the gate, the
    # same shape as the shim above. The glob is the subtree form: coverage's
    # `*` stops at one path segment and every pattern is anchored whole-path
    # (`*/pytest-of-*` therefore matched NOTHING — measured, the first edit
    # left all three 100% rows in the table), while `**/pytest-of-*/**` spans
    # any prefix, the pytest-of-<user> directory, and everything under it.
    **/pytest-of-*/**

[report]
# The floor tracks measured reality, not aspiration, and the PER-FILE shape is
# what `coverage report` prints — it is not restated here. An earlier version of
# this comment carried five per-file percentages and a TOTAL, and every one of
# them rotted: the suite's TOTAL has since moved well above this floor. A figure
# copied out of the report is a figure nobody recomputes, so the gate holds the
# one number that matters and the report holds the shape. Raise the floor only
# with new tests, never with omit-patterns.
fail_under = 70
show_missing = True
